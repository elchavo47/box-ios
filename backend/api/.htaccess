# Yalnızca index.php dışarıdan çağrılabilir; ayar, kütüphane ve önbellek dosyaları kapalı.
<FilesMatch "^(config|config\.sample|config_writer|lib)\.php$|^\.|\.(tmp|lock|sql|log)$">
    Require all denied
</FilesMatch>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^cache/ - [F,L]
    # Bazı hostinglerde Authorization başlığının PHP'ye ulaşması için
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
